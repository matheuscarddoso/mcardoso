# Absolute origin, no trailing slash, and the www host — ocardoso.com answers
# 308 to www.ocardoso.com, and a canonical pointing at a redirect is a defect.
#
# Every canonical, hreflang, sitemap entry, Open Graph image URL and JSON-LD @id
# is built from this. Getting it wrong doesn't degrade SEO, it voids it: the
# site once shipped with a default domain that had never been registered, so
# every one of those URLs resolved to nothing.
#
# Leave unset to use the built-in default (https://www.ocardoso.com). Set it
# only to point a fork or a staging host somewhere else.
NEXT_PUBLIC_SITE_URL=https://www.ocardoso.com

# Optional. Raises the GitHub REST limit from 60/h per IP, which is what feeds
# the profile hover card. Without it the card still renders — the fetch just
# fails more often on a shared IP, and the link falls back to a plain anchor.
# Needs no scopes: it only reads a public profile.
GITHUB_TOKEN=

# Spotify, for the "now playing" card on the playlists link. All three are
# required together; with any of them missing the card degrades to a plain
# link rather than erroring.
#
# The refresh token does not expire. Get one by creating an app at
# developer.spotify.com, adding http://127.0.0.1:8888/callback as a redirect
# URI, and running the authorisation code flow once with the scopes
# `user-read-currently-playing user-read-recently-played`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
