# Absolute origin, no trailing slash. Every canonical, hreflang, sitemap entry
# and JSON-LD @id is built from it — a wrong value here silently points the
# whole site's SEO at the wrong host. Defaults to https://mcardoso.dev.
NEXT_PUBLIC_SITE_URL=https://mcardoso.dev

# Optional. Raises the GitHub REST limit from 60/h per IP, which is what feeds
# the profile hover card. Without it the card still renders — the fetch just
# fails more often on a shared IP, and the link falls back to a plain anchor.
# Needs no scopes: it only reads a public profile.
GITHUB_TOKEN=
